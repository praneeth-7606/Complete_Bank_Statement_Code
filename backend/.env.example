MONGO_URI=mongodb://localhost:27017/financial
SECRET_KEY=replace-with-a-random-value-at-least-32-characters-long
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
MISTRAL_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
ZAI_API_KEY=
ZAI_MODEL=glm-4.7-flash
ZAI_VISION_MODEL=glm-4.6v-flash
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
LLM_TIMEOUT_SECONDS=30
MISTRAL_OCR_MODEL=mistral-ocr-4-1
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=financial-transactions
ENCRYPTION_KEY=
ENCRYPTION_SALT=
GROWW_API_KEY=
GROWW_API_SECRET=
GROWW_MCP_SERVER_COMMAND=
GROWW_MCP_SERVER_URL=
MAX_UPLOAD_SIZE_BYTES=26214400
MAX_UPLOAD_PAGES=100
MAX_BATCH_STATEMENTS=10

# Privacy: redact PII spans in the PDF before OCR providers see it.
# Default false (redaction can strip counterparty names and hurt accuracy).
OCR_MASK_PII_BEFORE_SEND=false
# LLM batching: free-tier polite defaults; raise both for enterprise scale.
LLM_BATCH_SIZE=20
LLM_MAX_CONCURRENT_BATCHES=2

# Frontend/browser E2E testing (use a dedicated non-production account)
E2E_BASE_URL=http://localhost:3001
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
E2E_STATEMENT_PATH=
E2E_STATEMENT_PASSWORD=
E2E_STATEMENT_PASSWORDS=
E2E_FIXTURE_DIR=e2e-fixtures
E2E_ARTIFACT_DIR=e2e-artifacts
AGENT_BROWSER_BIN=

# Optional LangSmith observability for E2E/LLM traces
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=financial-statement-analyzer
LANGCHAIN_TRACE_URL=
